# syntax=docker/dockerfile:1.7
#
# Образ web-интерфейса LMS: nginx + статика SPA.
# В образ попадает только то, что нужно браузеру: index.html, css/ и js/.
# Тесты, package.json и конфиг nginx в статику не копируются.
#
#   docker build -f infra/Dockerfile.web -t lms/web .
#
# Контекст сборки — корень репозитория (см. .dockerignore).
# Официальный образ nginx запускает master от root и сразу сбрасывает
# привилегии для worker-процессов; для статики этого достаточно.

ARG NGINX_IMAGE=nginx:1.27-alpine

FROM ${NGINX_IMAGE}

LABEL org.opencontainers.image.title="lms-web" \
      org.opencontainers.image.description="LMS web UI (static SPA + reverse proxy to gateway)"

COPY web/nginx.conf /etc/nginx/conf.d/default.conf

COPY web/index.html /usr/share/nginx/html/index.html
COPY web/css /usr/share/nginx/html/css
COPY web/js /usr/share/nginx/html/js

# Дефолтная страница образа не нужна — всё отдаёт index.html.
RUN rm -f /usr/share/nginx/html/50x.html /usr/share/nginx/html/index.html.bak

EXPOSE 80
