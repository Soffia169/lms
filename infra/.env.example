# Шаблон локальных секретов. Скопируйте в infra/.env — файл .env в .gitignore.
# Значения ниже совпадают с дефолтами docker-compose.yml, поэтому .env опционален.

# PostgreSQL
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_password
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=lms
RABBITMQ_PASSWORD=lms_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Web-интерфейс (nginx). Откройте http://localhost:8088 после docker compose up.
WEB_PORT=8088

# CORS для gateway: нужен только когда UI открыт отдельным сервером
# (например, node web/scripts/dev-server.js на 5500). Основной сценарий
# работает без CORS — nginx отдаёт статику и /api с одного origin.
# LMS_CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:5500,http://127.0.0.1:5500
